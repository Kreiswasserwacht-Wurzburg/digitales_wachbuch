    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.33.0",
    "node-sass": "^9.0.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.2",
    "sass-loader": "^16.0.5",
